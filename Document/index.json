{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solid-schema.github.io/Document/index.json",
  "title": "Document",
  "description": "A generic document — a self-contained piece of content with a title, body, and metadata. Spans foaf:Document, schema:CreativeWork, and as:Document.",
  "type": "object",
  "x-urn-solid": {
    "term": "urn:solid:Document",
    "termRegistry": "https://urn-solid.github.io/Document/",
    "status": "stable",
    "added": "2026-04-19",
    "curatedBy": "claude-curate-next"
  },
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "enum": ["Document", "urn:solid:Document"]
    },
    "name": {
      "description": "The Document's title.",
      "type": "string",
      "minLength": 1
    },
    "content": {
      "description": "The Document's body — plain text or HTML.",
      "type": "string"
    },
    "summary": {
      "description": "A short summary or excerpt.",
      "type": "string"
    },
    "mediaType": {
      "description": "MIME type of the content (text/html, text/markdown, application/pdf, …).",
      "type": "string",
      "pattern": "^[a-zA-Z0-9!#$&\\-^_+.]+/[a-zA-Z0-9!#$&\\-^_+.]+$"
    },
    "attributedTo": {
      "description": "The Person or Actor who authored the Document.",
      "anyOf": [
        { "type": "string", "format": "uri" },
        { "$ref": "https://solid-schema.github.io/Person/index.json" }
      ]
    },
    "published": {
      "type": "string",
      "format": "date-time"
    },
    "updated": {
      "type": "string",
      "format": "date-time"
    },
    "url": {
      "description": "Canonical web URL.",
      "type": "string",
      "format": "uri"
    }
  },
  "required": ["@type"],
  "additionalProperties": true
}
