{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solid-schema.github.io/Person/index.json",
  "title": "Person",
  "description": "A human person — schema for data typed as urn:solid:Person.",
  "type": "object",
  "x-urn-solid": {
    "term": "urn:solid:Person",
    "termRegistry": "https://urn-solid.com/Person/",
    "status": "stable",
    "added": "2026-04-19",
    "curatedBy": "claude-curate-next"
  },
  "properties": {
    "@id": {
      "description": "The Person's identifier (typically a WebID or DID).",
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "description": "The type marker. Bare 'Person' or the explicit urn:solid:Person form.",
      "type": "string",
      "enum": ["Person", "urn:solid:Person"]
    },
    "name": {
      "description": "The Person's full display name.",
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "nick": {
      "description": "A short nickname or handle.",
      "type": "string",
      "maxLength": 50
    },
    "email": {
      "description": "An email address.",
      "type": "string",
      "format": "email"
    },
    "homepage": {
      "description": "URL of the Person's primary website.",
      "type": "string",
      "format": "uri"
    },
    "img": {
      "description": "URL of an image of the Person.",
      "type": "string",
      "format": "uri"
    },
    "knows": {
      "description": "Other People this Person knows. Each entry is a WebID URI.",
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      }
    }
  },
  "required": ["@type"],
  "additionalProperties": true
}
